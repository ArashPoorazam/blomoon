BLOMOON_DOMAIN=blomoon.ir
BLOMOON_WWW_DOMAIN=www.blomoon.ir
BLOMOON_LOG_LEVEL=info
# Images and DATABASE_URL are constructed by deploy.sh.
# Values are literal dotenv values: quote secrets containing # or spaces.
GHCR_USERNAME=
GHCR_TOKEN=

TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=INFO

POSTGRES_DB=blomoon
POSTGRES_USER=blomoon
POSTGRES_PASSWORD=

BETTER_AUTH_URL=https://blomoon.ir
BETTER_AUTH_SECRET=
RESEND_API_KEY=
BLOMOON_AUTH_EMAIL_FROM="Blomoon <no-reply@example.com>"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verified account IDs allowed to manage radio stations (comma separated).
BLOMOON_ADMIN_USER_IDS=
# Start with observe; switch to enforce after backfill and health audit.
BLOMOON_RADIO_HEALTH_MODE=observe
