# Optional worker image; building it does not enable or deploy ingestion.
FROM node:26.12.1-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
RUN npm run ingestion:build
ENV NODE_ENV=production
USER node
CMD ["npm", "run", "ingestion:worker"]
