{
  "name": "blomoon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:check": "node scripts/check-db.mjs",
    "catalog:sync": "node --conditions=react-server --import tsx scripts/radio-catalog.ts --once",
    "catalog:worker": "node --conditions=react-server --import tsx scripts/radio-catalog.ts",
    "catalog:identities": "node --conditions=react-server --import tsx scripts/radio-identities.ts",
    "check:prod": "node scripts/check-production.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "health:worker": "node --conditions=react-server --import tsx scripts/radio-health.ts",
    "health:backfill": "node --conditions=react-server --import tsx scripts/radio-health.ts --backfill",
    "geo:sync": "node scripts/sync-country-metadata.mjs",
    "geo:check": "node scripts/sync-country-metadata.mjs --check"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "better-auth": "1.7.14",
    "d3-geo": "3.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.35.0",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@types/d3-geo": "3.1.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
