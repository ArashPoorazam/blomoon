{
  "name": "blomoon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "node scripts/check-db.mjs",
    "catalog:sync": "node --conditions=react-server --import tsx scripts/radio-catalog.ts --once",
    "catalog:worker": "node --conditions=react-server --import tsx scripts/radio-catalog.ts",
    "catalog:identities": "node --conditions=react-server --import tsx scripts/radio-identities.ts",
    "check:prod": "node scripts/check-production.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "health:worker": "node --conditions=react-server --import tsx scripts/radio-health.ts",
    "health:backfill": "node --conditions=react-server --import tsx scripts/radio-health.ts --backfill"
  },
  "dependencies": {
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "@types/d3-geo": "^3.1.1",
    "better-auth": "^1.7.1",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "latest",
    "next": "latest",
    "postgres": "^3.4.9",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.24.0",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "topojson-client": "latest",
    "world-atlas": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@types/topojson-client": "latest",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "latest",
    "vitest": "^4.1.11"
  }
}
