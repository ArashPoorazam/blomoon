DATABASE_URL=postgres://user:password@localhost:5432/blomoon
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
RESEND_API_KEY=
BLOMOON_AUTH_EMAIL_FROM="Blomoon <onboarding@resend.dev>"

# Optional OAuth provider. Google sign-in is hidden unless both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verified account IDs allowed to manage radio stations (comma separated).
BLOMOON_ADMIN_USER_IDS=
# Start with observe; switch to enforce after backfill and health audit.
BLOMOON_RADIO_HEALTH_MODE=observe

# Omnisire host collector: generate a separate random token (minimum 32 characters).
BLOMOON_COLLECTOR_TOKEN=
